{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Production-grade URL shortener — bit.ly clone",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js --env .env.prod",
    "dev": "nodemon src/index.js --env .env.dev",
    "local": "nodemon src/index.js --env .env.local",
    "seed:notifications": "node src/scripts/seed-notifications.js",
    "seed:analytics": "node src/scripts/seed-analytics.js",
    "seed:domains": "node src/scripts/seed-domains.js",
    "seed:users": "node src/scripts/seed-users.js",
    "simulate:load": "node src/scripts/simulate-load.js",
    "password": "node src/test.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.7.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
